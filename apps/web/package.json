{
  "name": "playpath-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "demo": "VITE_PROTECTED_DASH=/origin/manifest.mpd VITE_PROTECTED_HLS=/origin/master.m3u8 VITE_CLEAR_HLS=/clear/master.m3u8 VITE_LICENSE_URL=/license/ npm run build && node demo-server.mjs",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --check ."
  },
  "dependencies": {
    "hls.js": "1.7.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shaka-player": "5.2.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  }
}
